# Copy this file to .env (same folder) and fill in your key.
# .env is ignored by git, so your key never gets committed.

# Required: an API key from https://platform.claude.com (API keys page)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional
# ATLAS_WORKSPACE=~/uni          # folder ATLAS works in (default: your home folder)
# ATLAS_OWNER=Chaitanya          # what ATLAS calls you
# ATLAS_MODEL=claude-opus-5-5    # or claude-sonnet-5-5 / claude-haiku-5-5 to spend less
# ATLAS_BUDGET_USD=2             # spending cap per request
# ATLAS_AUTO_EDITS=1             # let file edits inside the workspace through without asking
